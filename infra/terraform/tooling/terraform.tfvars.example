# GitHub Actions OIDC role (defaults shown)
# github_repository           = "General-Abdul-HBO/my_infra"
# github_branch               = "main"
# github_owner_id             = 85952139     # curl -s https://api.github.com/repos/OWNER/REPO | jq '.owner.id, .id'
# github_repository_id        = 1404672337   # (GitHub puts these IDs in the token's "sub" claim)
# create_github_oidc_provider = true   # leave true. false ONLY if the FIRST apply fails with
#                                      # EntityAlreadyExists (provider made outside this stack).
#                                      # Flipping it later makes Terraform DELETE the provider.
