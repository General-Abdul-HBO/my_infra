# Terraform working dirs (provider binaries are ~800 MB)
**/.terraform/*

# State can contain secrets; keep it in a remote backend instead
*.tfstate
*.tfstate.*
crash.log
crash.*.log
tfplan
*.tfplan

# Local var overrides (commit the *.tfvars.example files instead)
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Generated by infra/terraform/bootstrap (contains your account ID)
infra/terraform/backend.hcl

# Java / Maven
example-app/target/

# Python / Ansible
__pycache__/
*.retry
.venv/

# Editors / OS
.idea/
*.iml
.DS_Store
Thumbs.db
